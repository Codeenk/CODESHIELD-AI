# Copy to .env and adjust. Every value is optional; defaults are safe for local use.

# --- Server ---------------------------------------------------------------
CODESHIELD_HOST=127.0.0.1
CODESHIELD_PORT=8000
CODESHIELD_LOG_LEVEL=INFO
CODESHIELD_JOB_WORKERS=3
CODESHIELD_MAX_ACTIVE_SCANS=3
CODESHIELD_FRONTEND_URL=http://127.0.0.1:8000
CODESHIELD_SECRET_KEY=change-me-to-a-long-random-value

# --- Authentication -------------------------------------------------------
# on = email/password (and optional GitHub OAuth); off = single local demo user.
CODESHIELD_AUTH=on
CODESHIELD_SESSION_TTL_DAYS=30
CODESHIELD_COOKIE_SECURE=false
# Static bearer token for CI. Maps to ci@codeshield.local.
# CODESHIELD_API_TOKEN=
# CODESHIELD_GITHUB_CLIENT_ID=
# CODESHIELD_GITHUB_CLIENT_SECRET=
# CODESHIELD_GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/github/callback

# --- Storage --------------------------------------------------------------
# CODESHIELD_DATA_DIR=backend/data
# CODESHIELD_DB=backend/data/codeshield.db

# --- Detection ------------------------------------------------------------
# off = rules-only (fast, deterministic); auto = use CodeBERT when installed.
CODESHIELD_MODEL_MODE=auto
CODESHIELD_MODEL=mrm8488/codebert-base-finetuned-detect-insecure-code
# CODESHIELD_MODEL_DIR=models/detector
CODESHIELD_ALLOW_MODEL_DOWNLOAD=false
CODESHIELD_MODEL_ONLY=false
CODESHIELD_MODEL_ONLY_THRESHOLD=0.92

# --- Repair ---------------------------------------------------------------
# none = deterministic templates only; auto = use a configured LLM endpoint.
CODESHIELD_REPAIR_PROVIDER=auto
CODESHIELD_MAX_PATCH_FINDINGS=100
# CODESHIELD_REPAIR_MAX_CANDIDATES=2
# CODESHIELD_REPAIR_MODEL=
# CODESHIELD_LLM_BASE_URL=http://127.0.0.1:8080/v1
# CODESHIELD_LLM_API_KEY=
# CODESHIELD_LLM_MODEL=qwen2.5-coder-1.5b-instruct
# CODESHIELD_LLM_TIMEOUT=180
# CODESHIELD_LLM_MAX_TOKENS=1200

# --- Sandbox / tests ------------------------------------------------------
# auto = Docker image when present, else constrained subprocess; off = static checks only.
CODESHIELD_SANDBOX=auto
CODESHIELD_RUN_TESTS=false
CODESHIELD_TEST_TIMEOUT=120
# CODESHIELD_SANDBOX_IMAGE=codeshield-sandbox:latest

# --- Privacy --------------------------------------------------------------
# Full function bodies are discarded after a scan unless explicitly retained.
CODESHIELD_RETAIN_CODE=false
CODESHIELD_MASK_SECRETS=true

# --- Ingestion ------------------------------------------------------------
CODESHIELD_MAX_FILE_BYTES=5242880
CODESHIELD_MAX_ARCHIVE_BYTES=52428800
CODESHIELD_MAX_TOTAL_BYTES=83886080
CODESHIELD_MAX_FILES=4000
CODESHIELD_REPO_TIMEOUT=180
CODESHIELD_REPO_HOSTS=github.com,gitlab.com,bitbucket.org
