# CodeShield AI configuration. Copy to `.env` and adjust. Never commit real secrets.

# --- Detection -------------------------------------------------------------
# Hugging Face checkpoint used by the neural detector (optional).
CODESHIELD_MODEL_ID=mrm8488/codebert-base-finetuned-detect-insecure-code
# Force-disable the neural detector (rules only). Useful for air-gapped/CI runs.
CODESHIELD_DISABLE_MODEL=0
# Confidence threshold above which a model-only finding is surfaced (precision-first).
CODESHIELD_MODEL_THRESHOLD=0.55

# --- Ingestion limits ------------------------------------------------------
CODESHIELD_MAX_FILE_MB=5
CODESHIELD_MAX_ARCHIVE_MB=50

# --- Privacy / retention ---------------------------------------------------
# Off by default: only findings metadata + content hashes are persisted.
CODESHIELD_RETAIN_CODE=0

# --- API -------------------------------------------------------------------
CODESHIELD_API_TOKEN=
CODESHIELD_HOST=127.0.0.1
CODESHIELD_PORT=8000

# --- Repair ----------------------------------------------------------------
# Optional: an OpenAI-compatible endpoint for the LLM repair model (Qwen2.5-Coder, ...).
# Template-based repair is always available and needs no key.
CODESHIELD_REPAIR_ENDPOINT=
CODESHIELD_REPAIR_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
CODESHIELD_REPAIR_API_KEY=
